cords by Id, meta_ExtractedDate, and SYS_CHANGE_VERSION\nWITH source_data AS (\n\nSELECT \t\t\n\t\t\tord.SalesOrderID as SalesOrderID,\n\t\t\tord.TerritoryID,\n\t\t\ttr.Name as TerritoryName,\n\t\t\ttr.Group as TerritoryGroup,\n\t\t\tord.TaxAmt,\n\t\t\tord.Freight,\n\t\t\tord.TotalDue,\n\t\t\tord.Comment,\n\t\t\tord.ModifiedDate\nFROM \"ci\".\"lh_silver\".\"orders\"  ord\nLEFT JOIN \"ci\".\"lh_silver\".\"territories\"  tr\nON ord.TerritoryID = tr.TerritoryID\n\n)\n\nselect * from source_data", "relation_name": "\"ci\".\"lh_gold\".\"order_territory\""}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-02-16T06:34:43.720974Z", "completed_at": "2026-02-16T06:34:43.742252Z"}, {"name": "execute", "started_at": "2026-02-16T06:34:43.746718Z", "completed_at": "2026-02-16T06:34:43.746725Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.037043094635009766, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.dbt_project.order_territory1", "compiled": true, "compiled_code": "\n\n-- CTE to rank CDC records by Id, meta_ExtractedDate, and SYS_CHANGE_VERSION\nWITH source_data AS (\n\nSELECT \tCASE WHEN ord.SalesOrderID < 50000 THEN\t\n \n      MD5(\n        CONCAT_WS(\n          '||',COALESCE(CAST(ord.TerritoryID AS string), '__NULL__'),COALESCE(CAST(tr.Group AS string), '__NULL__'),COALESCE(CAST(ord.SalesOrderID AS string), '__NULL__'))\n      ) ELSE 'NA' END AS order_sk,\n\t\t\t--md5(cast(coalesce(cast(ord.TerritoryID as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(tr.Group as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(ord.SalesOrderID as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS order_sk,\n\t\t\tord.SalesOrderID as SalesOrderID,\n\t\t\tord.TerritoryID,\n\t\t\ttr.Name as TerritoryName,\n\t\t\ttr.Group as TerritoryGroup,\n\t\t\tord.TaxAmt,\n\t\t\tord.Freight,\n\t\t\tord.TotalDue,\n\t\t\tord.Comment,\n\t\t\tord.ModifiedDate\nFROM \"ci\".\"lh_silver\".\"orders\"  ord\nL